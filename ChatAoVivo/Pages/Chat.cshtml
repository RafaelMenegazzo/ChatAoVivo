@page
@using System.Text.Json
@using Newtonsoft.Json
@using RazorPages.Pages
@using ChatAoVivo.Pages.Models
@using System
@model Chat

@{
    Layout = "_Layout";


}
@if (TempData.ContainsKey("Mensagens"))
{
   
    try
    {
        var jsonString = TempData["Mensagens"]?.ToString();
        var msg = JsonConvert.DeserializeObject<List<Message>>(jsonString);
        TempData.Keep("Mensagens");

        <ul>
            
            @foreach(Message sms in msg)
            {
                
            <li>
                <img src="C:\Users\User\source\repos\ChatAoVivo\ChatAoVivo\wwwroot\Images\@sms.user.img.ImageFile" alt="User-img"/>
                @sms.user.Nome: @sms.Msg
            </li>
            }
            

        </ul>

   
    }
    catch (Exception e)
    {
        
    }


}

@if(!TempData.ContainsKey("Mensagens"))
{
    <p>Não há mensagens</p>
}



<div class="messageRow">
<fieldset>

    <form method="post" asp-controller="Chat" asp-action="salvarMensagens">
    <input type="text" name="message" id="message" placeholder="Digite sua mensagem">
    <input type="submit" id="EnviarMessagem" value="Enviar"/>
    </form>

</fieldset>
</div>

@section Scripts{
    <script src="~/js/site.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="~/js/chat.js"></script>
} 