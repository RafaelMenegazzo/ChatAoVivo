@page
@using Newtonsoft.Json
@using RazorPages.Pages
@using ChatAoVivo.Pages.Models
@using System
@model Chat

@{
    Layout = "_Layout";


}
@if (TempData.ContainsKey("UserName") && TempData.ContainsKey("UserImg"))
{

    try
    {
        var Json = TempData["Mensagem"].ToString();
        List<Message> msg = JsonConvert.DeserializeObject<List<Message>>(Json);
        var nome = TempData["UserName"].ToString();
        var img =  TempData["UserImg"].ToString();
        TempData.Keep("UserName");
        TempData.Keep("UserImg");

        <ul>
            @foreach(Message message in msg)
            {
                <li>
                    <img src="data:image/png;base64,@message.user.img.ImageName" alt="User Image" width="50" height="50"/>
                    <strong>@message.user.Nome:</strong> @message.Msg;
                </li>
            }
        )
            {}
        </ul>
    if(nome != null)
    {
                <h2>Bem vindo, @nome</h2>
             
    }
    else
    {
        <h2>Nome nulo</h2>
    }
    }
    catch (Exception e)
    {
        
    }


}


<div class="messageRow">
<fieldset>

    <form method="post">
    <input type="text" id="message" placeholder="Digite sua mensagem">
    <input type="submit" id="EnviarMessagem" value="Enviar"/>
    </form>

</fieldset>
</div>
</div>

@section Scripts{
    <script src="~/js/site.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="~/js/chat.js"></script>
} 